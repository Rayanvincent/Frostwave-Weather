# Frostwave Weather Environment Variables
VITE_WEATHER_KEY=
VITE_WEATHER_URL=https://api.weatherapi.com/v1/forecast.json
VITE_SEARCH_URL=https://api.weatherapi.com/v1/search.json
VITE_GEMINI_KEY=
VITE_GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent
VITE_STREET_VIEW_KEY=

# Firebase Web App configuration (Firebase Console > Project settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=eyespy-weather
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=

# Server-only Firebase Admin credentials.
# Authenticate locally with `gcloud auth application-default login`, or point
# this at a service-account JSON stored outside the repository.
FIREBASE_PROJECT_ID=eyespy-weather
GOOGLE_APPLICATION_CREDENTIALS=
# Alternative for hosting providers that accept JSON secrets as environment values.
FIREBASE_SERVICE_ACCOUNT_JSON=
ADMIN_EMAILS=
APP_BASE_URL=http://localhost:5174
WEB_ORIGINS=http://localhost:5173,http://localhost:5174
